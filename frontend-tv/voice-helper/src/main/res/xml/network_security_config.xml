<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- The model endpoint is explicitly user-configured and may be a LAN HTTP address. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
