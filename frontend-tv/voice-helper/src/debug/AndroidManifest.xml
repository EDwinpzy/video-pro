<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".VoiceDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.dongpiandi.voicehelper.DEBUG_SUBMIT_TEXT" />
                <action android:name="com.dongpiandi.voicehelper.DEBUG_CANCEL" />
                <action android:name="com.dongpiandi.voicehelper.DEBUG_CONFIGURE" />
                <action android:name="com.dongpiandi.voicehelper.DEBUG_PRESS_VOICE" />
                <action android:name="com.dongpiandi.voicehelper.DEBUG_INJECT_PCM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
