<?xml version="1.0" encoding="utf-8"?>
<!-- The official app uses the public HTTPS service and trusts only the
     platform CA store. There is no private migration CA or IP override. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
