<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- 纯 D-pad 大屏应用：无触摸也可用（方案 §2.2） -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- The dictation path loads the projector's installed iFlytek engine directly. -->
    <queries>
        <package android:name="com.jmgo.ai.voice" />
        <package android:name="com.jmgo.hippo" />
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/ic_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:use32bitAbi="true"
        android:usesCleartextTraffic="true"
        android:usesNonSdkApi="true"
        android:theme="@style/Theme.OptimalTV">

        <service
            android:name=".dictation.SystemDictationService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="@string/system_dictation_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/system_dictation_service" />
        </service>

        <activity
            android:name=".dictation.DictationSetupActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/system_dictation_service_label"
            android:screenOrientation="landscape" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- TV 桌面入口 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v1.20：内嵌 python 后端宿主（:backend 独立进程；热更新免杀 app 重启后端） -->
        <service
            android:name=".BackendService"
            android:exported="false"
            android:process=":backend" />
    </application>
</manifest>
